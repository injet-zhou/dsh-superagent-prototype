#!/usr/bin/env python3
"""Account-isolated Gitea REST CLI and Git credential helper (Python 3.8+, no dependencies)."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Do not forward the agent's Authorization header to a redirect target."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def instance_url(value):
    url = urllib.parse.urlsplit(value)
    if (url.scheme not in ("http", "https") or not url.hostname or url.username
            or url.password or url.query or url.fragment):
        raise ValueError("config baseUrl must be an HTTP(S) instance root")
    return value.rstrip("/")


def api_url(base, path):
    decoded = urllib.parse.unquote(path)
    if (path.startswith("/") or ":" in decoded.split("?")[0] or "\\" in decoded
            or any(part in (".", "..") for part in decoded.split("?")[0].split("/"))):
        raise ValueError("API paths must be relative to this Gitea instance")
    return base + "/api/v1/" + path


def request(config, url, method="GET", data=None):
    headers = {"Authorization": "token " + config["token"], "Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.build_opener(NoRedirect()).open(req, timeout=60) as response:
            body = response.read(16 * 1024 * 1024 + 1)
            if len(body) > 16 * 1024 * 1024:
                raise ValueError("Gitea response exceeded 16 MiB")
            return json.loads(body) if body else None, response.headers
    except urllib.error.HTTPError as error:
        # Do not echo request bodies, headers, remote error text, or the token.
        raise ValueError("Gitea API failed (HTTP %s)" % error.code) from None
    except urllib.error.URLError:
        raise ValueError("Gitea connection failed") from None


def api(config, args):
    data = None
    fields = {}
    for field in args.field:
        key, separator, value = field.partition("=")
        if not separator:
            raise ValueError("fields must be name=value")
        fields[key] = value
    for field in args.typed_field:
        key, separator, value = field.partition("=")
        if not separator:
            raise ValueError("fields must be name=JSON")
        fields[key] = json.loads(value)
    if args.input:
        if fields:
            raise ValueError("use --input or fields, not both")
        if args.input == "-":
            data = json.load(sys.stdin)
        else:
            with open(args.input, encoding="utf-8") as stream:
                data = json.load(stream)
    elif fields:
        data = fields
    method = args.method or ("POST" if data is not None else "GET")
    if args.paginate and method != "GET":
        raise ValueError("pagination is only supported for GET")
    url = api_url(config["baseUrl"], args.path)
    pages = []
    visited = set()
    while True:
        if url in visited or len(visited) >= 1000:
            raise ValueError("Gitea pagination did not finish")
        visited.add(url)
        result, headers = request(config, url, method, json.dumps(data).encode() if data is not None else None)
        pages.append(result)
        if not args.paginate:
            break
        if not isinstance(result, list):
            raise ValueError("pagination requires an array response")
        # Follow the server's Link header; the server can cap a requested page size.
        next_url = None
        for link in headers.get("Link", "").split(","):
            if 'rel="next"' in link:
                next_url = urllib.parse.urljoin(url, link.split("<", 1)[1].split(">", 1)[0])
        if not next_url:
            break
        prefix = config["baseUrl"] + "/api/v1/"
        if not next_url.startswith(prefix):
            raise ValueError("Gitea pagination left the configured API")
        # Validate paths even when they came from a remote response.
        api_url(config["baseUrl"], next_url[len(prefix):])
        url = next_url
    result = pages if args.slurp else ([item for page in pages for item in page] if args.paginate else pages[0])
    print(json.dumps(result, ensure_ascii=False))


def credential(config, args):
    values = dict(line.rstrip("\n").split("=", 1) for line in sys.stdin if "=" in line)
    if args.operation != "get":
        return
    base = urllib.parse.urlsplit(config["baseUrl"])
    expected = (base.path.strip("/") + "/" + args.repository).lstrip("/")
    path = values.get("path", "")
    if path.endswith(".git"):
        path = path[:-4]
    if (values.get("protocol") != base.scheme or values.get("host") != base.netloc or path != expected):
        return
    user, _ = request(config, api_url(config["baseUrl"], "user"))
    if values.get("username") and values["username"] != user["login"]:
        return
    print("username=" + user["login"])
    print("password=" + config["token"])
    print()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default=os.environ.get("DSH_GITEA_CONFIG"))
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("config", help="print the instance URL, never credentials")
    rest = commands.add_parser("api", help="call a relative Gitea /api/v1 endpoint")
    rest.add_argument("path")
    rest.add_argument("--method", "-X")
    rest.add_argument("--field", "-f", action="append", default=[])
    rest.add_argument("--typed-field", "-F", dest="typed_field", action="append", default=[])
    rest.add_argument("--input")
    rest.add_argument("--paginate", action="store_true")
    rest.add_argument("--slurp", action="store_true")
    auth = commands.add_parser("auth")
    auth.add_argument("kind", choices=["git-credential"])
    auth.add_argument("--repository", required=True)
    auth.add_argument("operation", choices=["get", "store", "erase"])
    args = parser.parse_args()
    if not args.config:
        raise ValueError("set --config to the agent's private Gitea JSON configuration")
    with open(args.config, encoding="utf-8") as stream:
        config = json.load(stream)
    config["baseUrl"] = instance_url(config["baseUrl"])
    if not isinstance(config.get("token"), str) or not config["token"].strip() or any(ord(char) < 33 or ord(char) > 126 for char in config["token"]):
        raise ValueError("Gitea configuration needs an agent token")
    if args.command == "config":
        print(json.dumps({"baseUrl": config["baseUrl"]}))
    elif args.command == "api":
        api(config, args)
    else:
        credential(config, args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError) as error:
        # Config parse errors can include source text; only report known operational messages.
        message = str(error) if isinstance(error, ValueError) and not isinstance(error, json.JSONDecodeError) else "Cannot read Gitea configuration or response"
        print(message, file=sys.stderr)
        sys.exit(1)
